if PerFFMxMuscle == True:
    lowFFM = []
    midFFM = []
    highFFM = []

    #Change the muscle to BM, BA, AM, AA, QM, or QA
    muscle = 'QA'
    count = 0
    for index, row in df.iterrows():
        if row['PerFFM'] < 88:
            if row[muscle] != 'nan':
                lowFFM.append(row[muscle])
                count += 1
        elif row['PerFFM'] < 92 and row['PerFFM'] >= 88:
            midFFM.append(row[muscle])
            count += 1
        elif row['PerFFM'] >= 92:
            highFFM.append(row[muscle])
            count +=1 
    print (count)
    print(len(lowFFM))
    print(len(midFFM))
    print(len(highFFM))
    lowFFM = [x for x in lowFFM if not math.isnan(x)]
    midFFM = [x for x in midFFM if not math.isnan(x)]
    highFFM = [x for x in highFFM if not math.isnan(x)]
    print(lowFFM)
    print(midFFM)
    print(highFFM)
    print(lowFFM)
    dis = [lowFFM, midFFM, highFFM]
    figure = plt.figure(figsize=(15,6))
    ax = figure.add_subplot(111)
    ax.set_yticklabels(['Percent FFM < 88%','Percent FFM 88-92%','Percent FFM > 92%'])
    plt.title("Percent Fat Free Mass Compared to Quadricep Adipose Measurement (mm)")
    ax.get_xaxis().tick_bottom()
    ax.get_yaxis().tick_left()
    bp_low = ax.boxplot(dis, patch_artist = True, vert=0)
    plt.show()

